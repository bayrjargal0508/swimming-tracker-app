{
  "expo": {
    "name": "AquaMotion",
    "slug": "swimming-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aquamotion.png",
    "scheme": "swimmingtracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.swimmingtracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#011A4A",
        "foregroundImage": "./assets/images/aquamotion.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.swimmingtracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/aquamotion.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#011A4A",
          "image": "./assets/images/aquamotion.png",
          "imageWidth": 200
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "AquaMotion reads the swimming video you pick so it can analyze your technique."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
